# Dev: SQLite local. Produção (compose): PostgreSQL com schema credit_score via search_path
DATABASE_URL=sqlite:///./credit_score.db
# DATABASE_URL=postgresql+psycopg://erp:erp@postgres:5432/erp?options=-csearch_path%3Dcredit_score
ONBOARDING_API_URL=http://localhost:8081
PORT=8082
LOG_LEVEL=INFO

# Prefixo do API Gateway (nginx remove o prefixo; usado pelo /docs). Vazio em dev.
ROOT_PATH=
# RabbitMQ (exchange erp.events). Vazio = consumer desligado (no-op).
RABBITMQ_URL=
# RABBITMQ_URL=amqp://erp:erp@rabbitmq:5672/

AUTH0_DOMAIN=dev-slbrfj6dwk1pdeox.us.auth0.com
AUTH0_AUDIENCE=https://erp-banking-api
CORS_ORIGINS=["http://localhost:5173"]

# Análise do negócio por LLM (Claude). Chave vazia = só regras. NUNCA commite a chave.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-sonnet-5-5
